{
    "name": "ernestdefoe/flarum-showcase",
    "description": "Promote Extensions/Themes-tagged discussions to feature cards above the forum index.",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "flarum/tags": "^2.0"
    },
    "suggest": {
        "ernestdefoe/gh-readme": "Source of the [gh-readme repo=\"owner/name\"] shortcode that Showcase reads opening posts for to pick a cover image."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Showcase\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Showcase",
            "category": "feature",
            "icon": {
                "name": "fas fa-star",
                "backgroundColor": "#e9b949",
                "color": "#222"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
