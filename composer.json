{
    "name": "ernestdefoe/flarum-showcase",
    "description": "Promote Extensions/Themes-tagged discussions to feature cards above the forum index.",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "flarum/tags": "^2.0"
    },
    "suggest": {
        "ernestdefoe/gh-readme": "Source of the [gh-readme repo=\"owner/name\"] shortcode that Showcase reads opening posts for to pick a cover image."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Showcase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Showcase\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "extra": {
        "flarum-extension": {
            "title": "Showcase",
            "category": "feature",
            "icon": {
                "name": "fas fa-star",
                "backgroundColor": "#e9b949",
                "color": "#222"
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
